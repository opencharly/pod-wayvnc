#!/bin/sh
# wayvnc-wrapper — serve the Wayland compositor at $WAYLAND_DISPLAY over VNC on :5900.
#
# Compositor-agnostic: it waits for the Wayland socket it is told to serve and nothing
# else. The sway-specific steps below (the IPC wait and the 0.9.1 power-on workaround)
# run only when sway is the compositor behind that socket.
#
# Knobs (all optional):
#   WAYVNC_OUTPUT   the output to serve (e.g. HEADLESS-1); unset serves the first output
#   WAYVNC_MAX_FPS  max frame rate (wayvnc's default is 30)
SOCKET="${XDG_RUNTIME_DIR:-/tmp}/${WAYLAND_DISPLAY:-wayland-0}"
TIMEOUT=30
ELAPSED=0

# Phase 1: wait for the Wayland display socket.
while [ ! -e "$SOCKET" ] && [ "$ELAPSED" -lt "$TIMEOUT" ]; do
    sleep 1
    ELAPSED=$((ELAPSED + 1))
done
if [ ! -e "$SOCKET" ]; then
    echo "wayvnc-wrapper: Wayland socket $SOCKET not found after ${TIMEOUT}s" >&2
    exit 1
fi

# Phase 2 (sway only): wait for sway's IPC socket — it means sway is fully initialized
# and sway-wrapper has set the output resolution, so the first VNC frame has the final
# size.
SWAYSOCK=""
if pgrep -x sway >/dev/null 2>&1; then
    ELAPSED=0
    while [ "$ELAPSED" -lt "$TIMEOUT" ]; do
        SWAYSOCK=$(ls -t "${XDG_RUNTIME_DIR:-/tmp}"/sway-ipc.*.sock 2>/dev/null | head -1)
        [ -n "$SWAYSOCK" ] && break
        sleep 1
        ELAPSED=$((ELAPSED + 1))
    done
    # Let sway-wrapper finish setting the resolution.
    sleep 2
fi

WAYVNC_ARGS="--render-cursor"
if [ -n "$WAYVNC_OUTPUT" ]; then
    WAYVNC_ARGS="$WAYVNC_ARGS -o $WAYVNC_OUTPUT"
fi

# GPU-accelerated encoding — only for real displays, not headless.
if [ "$WLR_BACKENDS" != "headless" ] && ls /dev/dri/renderD* >/dev/null 2>&1; then
    WAYVNC_ARGS="$WAYVNC_ARGS --gpu"
fi

if [ -n "$WAYVNC_MAX_FPS" ]; then
    WAYVNC_ARGS="$WAYVNC_ARGS --max-fps=$WAYVNC_MAX_FPS"
fi

# wayvnc_needs_power_on: true when this wayvnc predates the headless-output fix.
# wayvnc <= 0.9.1 gates screen capture on zwlr_output_power_v1 mode events, which sway's
# headless backend never emits, so VNC frames stay gray until something toggles DPMS.
# Fixed upstream after 0.9.1: measured, wayvnc 0.10.2 on headless sway 1.12 serves a full
# frame with no workaround. Fedora 43/44, Debian 13 and Ubuntu 25.x still ship 0.9.1.
# An unparseable version keeps the workaround (the old, always-on behaviour).
wayvnc_needs_power_on() {
    ver=$(wayvnc --version 2>&1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    [ -z "$ver" ] && return 0
    [ "$(printf '%s\n%s\n' "$ver" "0.9.1" | sort -V | head -1)" = "$ver" ]
}

if [ "$WLR_BACKENDS" = "headless" ] && [ -n "$SWAYSOCK" ] && wayvnc_needs_power_on; then
    (
        # Wait for wayvnc to start listening.
        ELAPSED=0
        while [ "$ELAPSED" -lt 15 ]; do
            if ss -tlnp 2>/dev/null | grep -q ':5900 '; then
                break
            fi
            sleep 0.5
            ELAPSED=$((ELAPSED + 1))
        done
        sleep 0.5
        # Minimal VNC handshake to trigger output_acquire_power_on: wayvnc only binds
        # the power manager after a client completes the RFB security handshake.
        python3 -c "
import socket, struct, time
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(5)
try:
    s.connect(('127.0.0.1', 5900))
    s.recv(12)                          # server version
    s.send(b'RFB 003.008\n')           # client version
    n = struct.unpack('B', s.recv(1))[0]
    s.recv(n)                           # security types
    s.send(struct.pack('B', 1))         # choose None
    s.recv(4)                           # security result
    s.send(struct.pack('B', 1))         # ClientInit (shared)
    time.sleep(0.5)                     # let wayvnc bind power manager
except Exception:
    pass
finally:
    s.close()
" 2>/dev/null
        sleep 1
        # Toggle DPMS on the served output to emit the missing power event.
        export SWAYSOCK
        swaymsg "output ${WAYVNC_OUTPUT:-*} power on" >/dev/null 2>&1
    ) &
fi

exec wayvnc $WAYVNC_ARGS 0.0.0.0 5900
